# Copie este arquivo para .env e preencha com um token real.
# Necessário para o servidor MCP do GitHub (.mcp.json).
#
# Gere um fine-grained personal access token em:
# https://github.com/settings/personal-access-tokens
# Escopos mínimos: contents:read, pull_requests:read, issues:read
#
# Antes de abrir o Claude Code neste projeto, rode:
#   source .env
export GITHUB_PAT=

# Banco de dados SQLite (ADR 0004)
DATABASE_PATH=db.sqlite3

# Autenticação JWT (ADR 0005)
JWT_SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# RabbitMQ (ADR 0007)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=rabbitmq
RABBITMQ_QUEUE=player_events

# Worker publisher (ADR 0007): jogadores de teste fixos (crie-os via
# POST /auth/register com esses mesmos usernames) e intervalo, em
# segundos, entre ciclos de publicação.
PLAYER_USERNAME_1=player_test_01
PLAYER_USERNAME_2=player_test_02
PUBLISHER_INTERVAL_SECONDS=60
